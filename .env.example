# Copy to .env for local Docker Compose usage. These values are local-demo only.
POSTGRES_DB=opsforge
POSTGRES_USER=opsforge
POSTGRES_PASSWORD=opsforge_local_only

OPSFORGE_ENVIRONMENT=local
OPSFORGE_DATABASE_URL=postgresql+psycopg://opsforge:opsforge_local_only@db:5432/opsforge
OPSFORGE_SECRET_KEY=replace-with-a-long-random-local-secret
OPSFORGE_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
OPSFORGE_LOG_LEVEL=INFO

